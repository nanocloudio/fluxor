# Build output
target/
*.uf2
*.bin
vm/

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store

# AI
.claude/
.context/
.codex

# Local-only test artefacts at the repo root. Nothing under `/tests`
# is committed: `tests/harness` is an independent sub-workspace
# (its own Cargo.toml `[workspace]`) for host integration tests,
# and `tests/hardware` holds rig configs that depend on operator
# environment. The main build does not depend on anything here.
# The leading `/` anchors the pattern to the repo root.
/tests/
/tools/tests/
/examples/

# Rig mechanisms: the backend executables `fluxor rig` discovers (a smart
# plug, a TFTP root, picotool, a cloud account) and the bench tooling
# beside them. They describe the benches this project is tested on, the
# way `tests/hardware` describes the scenarios, and go the same way.
/tools/rig/

# The shadow repo's own git-dir. `/tests/` and `/tools/tests/` above are
# versioned in it rather than here (standards/test-tracking.md §4), so
# they are recoverable instead of existing only on one machine.
/.git-shadow/

# Host-test shims for excluded (non-workspace) module crates generate
# their own lockfile; not tracked (the crates carry no host-test deps).
modules/**/Cargo.lock
__pycache__/
