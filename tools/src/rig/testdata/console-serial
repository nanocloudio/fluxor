#!/usr/bin/env python3
"""console-serial — a console double that replays a feed file.

Never installed. Tails binding `feed`, emitting `{"kind":"boot"}` for a
line `B:` and a bytes event for a line `T:<text>`, so a test drives the
console from the other backends: the deploy double writes the previous
image's output at stage, the power double writes a boot and the new
image's output at cycle. Binding `boot_on_open` emits a boot event
on attach, before `ready` — what a backend must never do for a device that
was already running, and what the orchestrator must ignore.
"""
import base64
import json
import os
import signal
import sys
import time

STOP = False


def emit(event):
    sys.stdout.write(json.dumps(event) + "\n")
    sys.stdout.flush()


def main():
    global STOP
    raw = sys.stdin.read()
    inv = json.loads(raw) if raw.strip() else {}
    binding = inv.get("binding", {}) or {}
    feed = binding.get("feed")

    def on_term(_sig, _frm):
        global STOP
        STOP = True

    signal.signal(signal.SIGTERM, on_term)
    # What a backend reports on opening comes before `ready`: it is part of
    # the open, and the orchestrator does not act until `ready`.
    if binding.get("boot_on_open"):
        emit({"kind": "boot"})
    emit({"kind": "ready"})
    pos = 0
    while not STOP:
        if feed and os.path.exists(feed):
            with open(feed) as f:
                f.seek(pos)
                for line in f:
                    if not line.endswith("\n"):
                        break
                    pos += len(line)
                    if line.startswith("B:"):
                        emit({"kind": "boot"})
                    elif line.startswith("T:"):
                        emit({"kind": "bytes", "data": base64.b64encode(line[2:].encode()).decode()})
        time.sleep(0.03)
    return 0


if __name__ == "__main__":
    sys.exit(main())
